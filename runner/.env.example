# Kopiér til runner/.env og udfyld. runner/.env er git-ignoreret.

# Repoet som runneren kloner ind i runner/arbejde/repo og pusher branches til
FABRIK_REPO_URL=https://github.com/<ejer>/software-fabrik.git

# Delt hemmelighed: samme værdi som i n8n-credentialen "Fabrik Runner" (Header Auth, navn X-Fabrik-Token)
FABRIK_TOKEN=skift-mig-til-en-lang-tilfaeldig-streng

# 127.0.0.1 er nok: Docker Desktop sender host.docker.internal videre til værtens localhost, så runneren ikke er synlig på netværket
FABRIK_VAERT=127.0.0.1
FABRIK_PORT=8765

# Kodeagent (Claude Code CLI) og evt. model
FABRIK_AGENT=claude
FABRIK_MODEL=
FABRIK_TIMEOUT_MIN=30
FABRIK_MAX_TURNS=80
